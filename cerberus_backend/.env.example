# ==============================================================================
# CERBERUSPAY ENVIRONMENT CONFIGURATION
# ==============================================================================

# Operation Mode: SIMULATION | SANDBOX | PRODUCTION
CERBERUS_MODE=SIMULATION

# Fraud Risk Alert Threshold (0 - 100)
# Transactions evaluated with risk_score >= threshold will trigger an SMTP alert
FRAUD_ALERT_THRESHOLD=80

# ------------------------------------------------------------------------------
# SMTP EMAIL NOTIFICATION SERVICE
# ------------------------------------------------------------------------------
# For Gmail: Use smtp.gmail.com with an App Password (not your normal password)
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to "App passwords" -> Create named "CerberusPay" -> Copy 16-character code
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
ALERT_FROM_EMAIL=your_email@gmail.com
ALERT_TO_EMAIL=fraud-team@example.com

# Optional Gateway Credentials (for SANDBOX mode)
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=whsec_cerberus_test_key_920